// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  bio       String?
  avatar    String?
  cover     String?
  phone     String?
  city      String?
  country   String?
  website   String?
  birthday  String?
  gender    String?
  work      String?
  education String?
  languages String?
  language  String   @default("ru") // Interface language
  isPublic  Boolean  @default(true)
  profileViews Int @default(0)
  
  role      String   @default("USER") // 'USER', 'ADMIN', 'MODERATOR'
  isBanned  Boolean  @default(false)

  // Settings
  privacySettings      Json? // { profileVisibility: 'public'|'friends'|'private', messagePermission: 'all'|'friends', ... }
  notificationSettings Json? // { email: boolean, push: boolean, sms: boolean, types: { likes: boolean, ... } }
  themeSettings        Json? // { theme: 'light'|'dark', color: 'blue', ... }
  
  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  posts          Post[]
  comments       Comment[]
  sentMessages   Message[] @relation("sender")
  receivedMessages Message[] @relation("receiver")
  notifications  Notification[]
  friends        User[]   @relation("Friends")
  friendOf       User[]   @relation("Friends")
  blockedUsers   User[]   @relation("BlockedUsers")
  blockedBy      User[]   @relation("BlockedUsers")
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  bookmarks      Bookmark[]
  bookmarkedBy   Bookmark[] @relation("BookmarkedUser")
  reports        Report[]
  
  // Market Relations
  ownedShops     Shop[]
  cart           Cart?
  orders         Order[]
  productReviews ProductReview[]
  
  // Media
  music          Music[]
  videos         Video[]
  stories        Story[]
  albums         Album[]
  photos         Photo[]
  photoTags      PhotoTag[]

  // Communities
  communities    CommunityMember[]

  // Support
  supportTickets SupportTicket[]
}

// Community model
model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // unique identifier for URL
  description String?
  avatar      String?
  cover       String?
  type        String   @default("public") // 'group', 'public', 'event'
  category    String?  // 'IT', 'Music', 'Games', etc.
  
  // Settings
  isVerified  Boolean  @default(false)
  website     String?
  location    String?
  
  // Stats
  membersCount Int     @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     CommunityMember[]
  posts       Post[]
  bookmarks   Bookmark[]
}

// Community Member model
model CommunityMember {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  role        String    @default("MEMBER") // 'OWNER', 'ADMIN', 'MODERATOR', 'MEMBER'
  joinedAt    DateTime  @default(now())

  @@unique([userId, communityId])
}

// Story model
model Story {
  id        String   @id @default(cuid())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  mediaUrl  String
  type      String   // 'image' | 'video'
  views     Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Post model
model Post {
  id        String   @id @default(cuid())
  content   String
  image     String?  // Optional image URL
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  likes     String[] // Array of usernames who liked
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Repost relation
  originalPostId String?
  originalPost   Post?   @relation("Reposts", fields: [originalPostId], references: [id])
  reposts        Post[]  @relation("Reposts")

  // Community relation
  community      Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId    String?

  // Relations
  comments  Comment[]
  bookmarks Bookmark[]
  reports   Report[]
}

// Comment model
model Comment {
  id        String   @id @default(cuid())
  content   String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  photo     Photo?   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId   String?
  likes     String[] // Array of usernames who liked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Album model
model Album {
  id          String   @id @default(cuid())
  title       String
  description String?
  cover       String?
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String
  privacy     String   @default("PUBLIC") // PUBLIC, FRIENDS, ONLY_ME
  isSystem    Boolean  @default(false)
  photos      Photo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Photo model
model Photo {
  id          String   @id @default(cuid())
  url         String
  description String?
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId  String
  album       Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)
  albumId     String?
  
  likes       String[]
  comments    Comment[]
  tags        PhotoTag[]
  bookmarks   Bookmark[]
  
  isArchived  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  privacy     String   @default("PUBLIC")
  
  width       Int?
  height      Int?
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Photo Tag model
model PhotoTag {
  id        String   @id @default(cuid())
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  x         Float
  y         Float
  createdAt DateTime @default(now())
  
  @@unique([photoId, userId])
}

// Message model
model Message {
  id        String   @id @default(cuid())
  content   String
  sender    User     @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  receiver  User     @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String
  read      Boolean  @default(false)
  
  attachmentUrl  String?
  attachmentType String? // 'image', 'video', 'audio', 'file'
  attachmentName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notification model
model Notification {
  id        String   @id @default(cuid())
  type      String   // 'friend_request' | 'post_like' | 'comment' | 'message'
  fromUser  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FriendRequest {
  id        String   @id @default(cuid())
  sender    User     @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  receiver  User     @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String
  status    String   @default("PENDING") // 'PENDING', 'ACCEPTED', 'REJECTED'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
}

model Bookmark {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  // Content Types
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?

  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String?

  targetUser User?   @relation("BookmarkedUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId String?

  photo     Photo?   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId   String?

  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId   String?

  // Metadata
  tags      String[] // Custom tags
  isViewed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, communityId])
  @@unique([userId, targetUserId])
  @@unique([userId, photoId])
  @@unique([userId, videoId])
}

model Report {
  id        String   @id @default(cuid())
  reporter  User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  reason    String
  createdAt DateTime @default(now())
}

// Music model
model Music {
  id        String   @id @default(cuid())
  title     String
  artist    String
  url       String
  cover     String?
  duration  Int?     // in seconds
  uploader  User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  createdAt DateTime @default(now())
}

// Video model
model Video {
  id        String   @id @default(cuid())
  title     String
  description String?
  url       String
  thumbnail String?
  views     Int      @default(0)
  uploader  User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  bookmarks Bookmark[]
  createdAt DateTime @default(now())
}

// Help Center Models

model HelpCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  icon        String?       // Emoji or icon name
  order       Int           @default(0)
  articles    HelpArticle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model HelpArticle {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  content     String       // HTML or Markdown
  excerpt     String?
  isPublished Boolean      @default(true)
  views       Int          @default(0)
  helpful     Int          @default(0)
  notHelpful  Int          @default(0)
  
  category    HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SupportTicket {
  id          String           @id @default(cuid())
  subject     String
  status      String           @default("OPEN") // OPEN, IN_PROGRESS, CLOSED, RESOLVED
  priority    String           @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  category    String?          // e.g. "Account", "Billing"
  
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  
  messages    SupportMessage[]
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SupportMessage {
  id        String        @id @default(cuid())
  content   String
  isStaff   Boolean       @default(false) // true if sent by support agent
  read      Boolean       @default(false)
  
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  
  createdAt DateTime      @default(now())
}

// Market Models

model Shop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  cover       String?
  isVerified  Boolean  @default(false)
  rating      Float    @default(0)
  
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String

  products    Product[]
  orderItems  OrderItem[] // Relation to items sold by this shop
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  image       String?
  
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId    String?
  children    ProductCategory[] @relation("CategoryHierarchy")
  
  products    Product[]
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Product {
  id            String   @id @default(cuid())
  title         String
  description   String   
  price         Float
  discountPrice Float?
  images        String[]
  stock         Int      @default(0)
  soldCount     Int      @default(0)
  rating        Float    @default(0)
  specifications Json?   
  
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId        String
  
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId    String
  
  reviews       ProductReview[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductReview {
  id        String   @id @default(cuid())
  rating    Int      
  text      String?
  images    String[]
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  
  items     CartItem[]
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  
  quantity  Int      @default(1)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  
  status        String      @default("PENDING") 
  totalAmount   Float
  
  contactName   String
  contactPhone  String
  address       String
  comment       String?
  
  items         OrderItem[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  
  shop      Shop     @relation(fields: [shopId], references: [id])
  shopId    String
  
  quantity  Int
  price     Float    
  
  status    String   @default("PENDING") 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

