// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String  @unique
  password     String
  firstName    String?
  lastName     String?
  bio          String?
  avatar       String?
  cover        String?
  phone        String?
  city         String?
  country      String?
  website      String?
  birthday     String?
  gender       String?
  work         String?
  education    String?
  languages    String?
  isPublic     Boolean @default(true)
  profileViews Int     @default(0)

  role     String  @default("USER") // 'USER', 'ADMIN', 'MODERATOR'
  isBanned Boolean @default(false)

  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  posts                  Post[]
  comments               Comment[]
  sentMessages           Message[]       @relation("sender")
  receivedMessages       Message[]       @relation("receiver")
  notifications          Notification[]
  friends                User[]          @relation("Friends")
  friendOf               User[]          @relation("Friends")
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  bookmarks              Bookmark[]
  reports                Report[]

  // Media
  music     Music[]
  videos    Video[]
  stories   Story[]
  albums    Album[]
  photos    Photo[]
  photoTags PhotoTag[]

  // Communities
  communities CommunityMember[]
}

// Community model
model Community {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique // unique identifier for URL
  description String?
  avatar      String?
  cover       String?
  type        String  @default("public") // 'group', 'public', 'event'
  category    String? // 'IT', 'Music', 'Games', etc.

  // Settings
  isVerified Boolean @default(false)
  website    String?
  location   String?

  // Stats
  membersCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members CommunityMember[]
  posts   Post[]
}

// Community Member model
model CommunityMember {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String
  role        String    @default("MEMBER") // 'OWNER', 'ADMIN', 'MODERATOR', 'MEMBER'
  joinedAt    DateTime  @default(now())

  @@unique([userId, communityId])
}

// Story model
model Story {
  id        String   @id @default(cuid())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  mediaUrl  String
  type      String // 'image' | 'video'
  views     Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Post model
model Post {
  id        String   @id @default(cuid())
  content   String
  image     String? // Optional image URL
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  likes     String[] // Array of usernames who liked
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Repost relation
  originalPostId String?
  originalPost   Post?   @relation("Reposts", fields: [originalPostId], references: [id])
  reposts        Post[]  @relation("Reposts")

  // Community relation
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String?

  // Relations
  comments  Comment[]
  bookmarks Bookmark[]
  reports   Report[]
}

// Comment model
model Comment {
  id        String   @id @default(cuid())
  content   String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  photo     Photo?   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId   String?
  likes     String[] // Array of usernames who liked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Album model
model Album {
  id          String   @id @default(cuid())
  title       String
  description String?
  cover       String?
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String
  privacy     String   @default("PUBLIC") // PUBLIC, FRIENDS, ONLY_ME
  isSystem    Boolean  @default(false)
  photos      Photo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Photo model
model Photo {
  id          String  @id @default(cuid())
  url         String
  description String?
  uploader    User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId  String
  album       Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)
  albumId     String?

  likes    String[]
  comments Comment[]
  tags     PhotoTag[]

  isArchived Boolean @default(false)
  isPinned   Boolean @default(false)
  privacy    String  @default("PUBLIC")

  width  Int?
  height Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Photo Tag model
model PhotoTag {
  id        String   @id @default(cuid())
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  photoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  x         Float
  y         Float
  createdAt DateTime @default(now())

  @@unique([photoId, userId])
}

// Message model
model Message {
  id         String   @id @default(cuid())
  content    String
  sender     User     @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   String
  receiver   User     @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Notification model
model Notification {
  id        String   @id @default(cuid())
  type      String // 'friend_request' | 'post_like' | 'comment' | 'message'
  fromUser  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FriendRequest {
  id         String   @id @default(cuid())
  sender     User     @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   String
  receiver   User     @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String
  status     String   @default("PENDING") // 'PENDING', 'ACCEPTED', 'REJECTED'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([senderId, receiverId])
}

model Bookmark {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Report {
  id         String   @id @default(cuid())
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  reason     String
  createdAt  DateTime @default(now())
}

// Music model
model Music {
  id         String   @id @default(cuid())
  title      String
  artist     String
  url        String
  cover      String?
  duration   Int? // in seconds
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  createdAt  DateTime @default(now())
}

// Video model
model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String
  thumbnail   String?
  views       Int      @default(0)
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId  String
  createdAt   DateTime @default(now())
}
